# Root-level environment example (shared defaults).
# Copy to .env and adjust per environment. Never commit real secrets.

# PostgreSQL (matches docker-compose.yml)
POSTGRES_USER=aggelog
POSTGRES_PASSWORD=
POSTGRES_DB=aggelog

# Prisma / API database connection
# 개발용 기본값 (운영 배포 시 .env에서 실제 값으로 교체)
DATABASE_URL=postgresql://aggelog:aggelog_dev_password@localhost:5432/aggelog?schema=public

# Redis (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379

# API 키 인증 (MVP) — X-API-Key 헤더 이름
API_KEY_HEADER=X-API-Key

# 시드 회원 apiKey (prisma/seed.ts). 비워두면 시드가 64자 랜덤 키를 생성합니다.
# 개발 중 고정 키가 필요하면 이곳에 직접 설정하세요(커밋 금지 — .env에 두세요).
SEED_API_KEY=

# MCP 서버 인증 키 (stdio — 서버 시작 시 1회 인증). API 키와 동일 키 사용.
# 필수: 설정하지 않으면 MCP 서버가 시작을 거부한다. 실제 키로 채워라.
MCP_API_KEY=

# CORS 허용 origin 목록 (콤마 구분). 와일드카드(*)는 허용하지 않는다.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# 마이데이터 (금융결제원) 연동 — 본인신용정보관리업자 등록 후 발급된 자격증명.
# MYDATA_MODE=real 로 설정하면 실제 HTTP 연동을 사용하고, mock(기본)이면
# 로컬 샘플 데이터를 반환한다. real 모드에서 자격증명이 없으면 명확한 설정 에러를 반환한다.
MYDATA_MODE=mock
MYDATA_BASE_URL=
MYDATA_CLIENT_ID=
MYDATA_CLIENT_SECRET=
