# apps/api environment example. Copy to .env and adjust.
# Never commit real secrets.

# HTTP port for the NestJS API
PORT=3001

# PostgreSQL connection (Prisma / TypeORM)
DATABASE_URL=postgresql://aggelog:@localhost:5432/aggelog?schema=public

# Redis connection (BullMQ / cache)
REDIS_URL=redis://localhost:6379

# API 키 인증 (MVP) — X-API-Key 헤더 이름
API_KEY_HEADER=X-API-Key

# CORS 허용 origin 목록 (콤마 구분). 와일드카드(*)는 허용하지 않는다.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
