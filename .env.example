# Root-level environment example (shared defaults).
# Copy to .env and adjust per environment. Never commit real secrets.

# PostgreSQL (matches docker-compose.yml)
POSTGRES_USER=aggelog
POSTGRES_PASSWORD=
POSTGRES_DB=aggelog

# Prisma / API database connection
DATABASE_URL=postgresql://aggelog:@localhost:5432/aggelog?schema=public

# Redis (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379

# 마이데이터 (금융결제원) 연동 — 본인신용정보관리업자 등록 후 발급된 자격증명.
# MYDATA_MODE=real 로 설정하면 실제 HTTP 연동을 사용하고, mock(기본)이면
# 로컬 샘플 데이터를 반환한다. real 모드에서 자격증명이 없으면 명확한 설정 에러를 반환한다.
MYDATA_MODE=mock
MYDATA_BASE_URL=
MYDATA_CLIENT_ID=
MYDATA_CLIENT_SECRET=
